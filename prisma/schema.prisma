generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
}

model Admin {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         AdminRole  @default(ADMIN)
  isSuspended  Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([email, role])
}

enum LicenseStatus {
  ACTIVE
  EXPIRING_SOON
  EXPIRED
  SUSPENDED
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  orders       Order[]
  licenses     License[]
  sessions     Session[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Product {
  id          String    @id
  slug        String    @unique
  name        String
  platform    String
  category    String
  priceCents  Int
  active      Boolean   @default(true)
  version     String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  orderItems  OrderItem[]
  licenses    License[]
}

model Order {
  id            String       @id @default(cuid())
  userId        String
  status        OrderStatus  @default(PENDING)
  currency      String       @default("USD")
  totalCents    Int
  provider      String?
  providerRef   String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  items         OrderItem[]
  licenses      License[]

  @@index([userId, createdAt])
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  productId  String
  unitCents  Int
  quantity   Int     @default(1)
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product @relation(fields: [productId], references: [id])
}

model License {
  id             String        @id @default(cuid())
  key            String        @unique
  userId         String
  productId      String
  orderId        String
  status         LicenseStatus  @default(ACTIVE)
  expiresAt      DateTime?
  allowedDevices Int           @default(1)
  activations    Int           @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  product        Product       @relation(fields: [productId], references: [id])
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([productId, status])
}

enum InquiryStatus {
  NEW
  CONTACTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Inquiry {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String? //aded cus in userstore front there is already a field while user sending message
  message   String        @db.Text
  status    InquiryStatus @default(NEW)
  notes     String?       @db.Text // additinally aded cus if user want thay can manage notes for that perticuler query 
  ipAddress String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([email])
}
